# Скопируйте в .env и поменяйте значения
PORT=3000
# 127.0.0.1 - только этот ПК; 0.0.0.0 - доступ с других устройств в сети
HOST=127.0.0.1
# Часовой пояс ПК (для Windows можно не указывать)
# TZ=Europe/Moscow

# Пароли и секрет (длинная случайная строка)
ADMIN_PASSWORD=change-me-admin
OPERATOR_PASSWORD=change-me-operator
SESSION_SECRET=change-me-long-random-string
SESSION_HOURS=12

# Текст на номерке
BRAND_NAME=5D Фильмы
TICKET_FOOTER=Приходите к указанному времени
LOCALE=ru-RU
